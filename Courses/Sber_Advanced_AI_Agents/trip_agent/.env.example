OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# GigaChat, via a local gpt2giga proxy (http://localhost:8090) exposing an
# OpenAI-compatible endpoint. GIGACHAT_SCOPE/CREDENTIALS/VERIFY_SSL_CERTS and
# GPT2GIGA_PASS_MODEL configure the gpt2giga process itself, not this app —
# this app only reads GIGACHAT_BASE_URL.
GIGACHAT_SCOPE=
GIGACHAT_CREDENTIALS=
GIGACHAT_VERIFY_SSL_CERTS=
GPT2GIGA_PASS_MODEL=
GIGACHAT_BASE_URL=http://localhost:8090/v1
